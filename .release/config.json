{
  "name": "狐径",
  "runs_on": "windows-latest",
  "branch": "main",
  "python": "3.15.2",
  "deps": [
    "\"pyinstaller==6.22.3\""
  ],
  "build": [
    "python build_exe.py"
  ],
  "outputs": [
    "FoxPath.exe"
  ],
  "version_source": "github_direct.py:APP_VERSION",
  "preflight": [
    "python tools/preflight_release.py --dry-run --skip-remote"
  ],
  "sign": {
    "enabled": true,
    "key_env": "RELEASE_SIGN_KEY",
    "command": "python make_version_json.py --sign-key {key}",
    "outputs": [
      "version.json",
      "version.json.sig"
    ],
    "pubkey_source": "github_direct.py:UPDATE_PUBKEY",
    "version_file": "version.json"
  },
  "checksums": {
    "file": "",
    "files": []
  },
  "publish": {
    "github": {
      "owner": "kele551",
      "repo": "FoxPath"
    },
    "extra": []
  },
  "commit_back": [
    "version.json",
    "version.json.sig"
  ]
}
